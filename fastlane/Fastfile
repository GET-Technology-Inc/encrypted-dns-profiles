# fastlane lanes for encrypted-dns-profiles.
#
#   bundle exec fastlane sign_profiles
#
# Locally the Developer ID identity is expected in the login keychain.
# On CI, set MATCH_GIT_URL (plus MATCH_PASSWORD and git credentials) and the
# lane will pull the developer_id certificate with match into a temporary
# keychain before signing.

default_platform(:mac)

# match prints a summary table of all its options, and long values get wrapped
# across lines, which defeats the secret masking in CI logs. Keep the storage
# location and credentials out of that table entirely.
::FastlaneCore::PrintTable.singleton_class.class_eval do
  alias_method :print_values_without_redaction, :print_values

  def print_values(config: nil, title: nil, hide_keys: [], mask_keys: [], transform: :newline)
    redacted = hide_keys + [
      :git_url, :git_branch, :git_basic_authorization, :git_bearer_authorization,
      :git_private_key, :keychain_name, :keychain_password, :app_identifier,
    ]
    print_values_without_redaction(config: config, title: title, hide_keys: redacted, mask_keys: mask_keys, transform: transform)
  end
end

IDENTITY = ENV.fetch("SIGNING_IDENTITY", "Developer ID Application: GET TECHNOLOGY INC. (FAW8H2KWX2)")

platform :mac do
  desc "Generate profiles, sign them with the Developer ID identity, verify the result"
  lane :sign_profiles do
    sh("cd .. && swift run --configuration release generate")

    if ENV["MATCH_GIT_URL"] && !ENV["MATCH_GIT_URL"].empty?
      setup_ci if is_ci
      match(
        type: "developer_id",
        git_url: ENV["MATCH_GIT_URL"],
        git_branch: ENV.fetch("MATCH_GIT_BRANCH", "master"),
        readonly: true,
        platform: "macos",
        team_id: ENV.fetch("MATCH_TEAM_ID", "FAW8H2KWX2"),
        app_identifier: "tw.com.getinfo.dns",
        skip_provisioning_profiles: true,
        keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
      )
    end

    sh("cd .. && SIGNING_IDENTITY='#{IDENTITY}' scripts/sign.sh profiles dist")
    sh("cd .. && scripts/verify.sh dist")
  end
end
