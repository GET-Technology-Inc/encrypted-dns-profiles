<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ConsentText</key>
	<dict>
		<key>default</key>
		<string>This profile only changes the DNS resolver used by this device to an encrypted one (DNS over HTTPS / DNS over TLS). It does not install certificates, VPNs, or any management. You can remove it at any time from Settings.</string>
		<key>en</key>
		<string>This profile only changes the DNS resolver used by this device to an encrypted one (DNS over HTTPS / DNS over TLS). It does not install certificates, VPNs, or any management. You can remove it at any time from Settings.</string>
		<key>zh-Hant</key>
		<string>此描述檔只會把裝置使用的 DNS 解析器改成加密連線（DNS over HTTPS / DNS over TLS），不會安裝憑證、VPN 或任何管理設定，隨時可在「設定」中移除。</string>
	</dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>TLS</string>
				<key>ServerAddresses</key>
				<array>
					<string>94.140.14.14</string>
					<string>94.140.15.15</string>
					<string>2a10:50c0::ad1:ff</string>
					<string>2a10:50c0::ad2:ff</string>
				</array>
				<key>ServerName</key>
				<string>dns.adguard-dns.com</string>
			</dict>
			<key>PayloadDescription</key>
			<string>DNS over TLS via dns.adguard-dns.com</string>
			<key>PayloadDisplayName</key>
			<string>DNS over TLS: AdGuard DNS</string>
			<key>PayloadIdentifier</key>
			<string>tw.com.getinfo.dns.adguard.dot.dnsSettings</string>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadUUID</key>
			<string>34B70829-C238-5296-8A32-3A073F67B77D</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>ProhibitDisablement</key>
			<false/>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>AdGuard DNS (Default). Blocks ads and trackers at the DNS level.
AdGuard DNS（預設版），在 DNS 層擋廣告與追蹤器。

DNS over TLS: dns.adguard-dns.com</string>
	<key>PayloadDisplayName</key>
	<string>AdGuard DNS (DoT)</string>
	<key>PayloadIdentifier</key>
	<string>tw.com.getinfo.dns.adguard.dot</string>
	<key>PayloadOrganization</key>
	<string>珈特科技股份有限公司 GET Technology Inc.</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>3C9F64B3-8A35-503E-98AD-CD6E9E08603C</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
