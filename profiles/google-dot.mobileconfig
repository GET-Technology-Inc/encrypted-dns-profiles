<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ConsentText</key>
	<dict>
		<key>default</key>
		<string>This profile only changes the DNS resolver used by this device to an encrypted one (DNS over HTTPS / DNS over TLS). It does not install certificates, VPNs, or any management. You can remove it at any time from Settings.</string>
		<key>en</key>
		<string>This profile only changes the DNS resolver used by this device to an encrypted one (DNS over HTTPS / DNS over TLS). It does not install certificates, VPNs, or any management. You can remove it at any time from Settings.</string>
		<key>zh-Hant</key>
		<string>此描述檔只會把裝置使用的 DNS 解析器改成加密連線（DNS over HTTPS / DNS over TLS），不會安裝憑證、VPN 或任何管理設定，隨時可在「設定」中移除。</string>
	</dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>TLS</string>
				<key>ServerAddresses</key>
				<array>
					<string>8.8.8.8</string>
					<string>8.8.4.4</string>
					<string>2001:4860:4860::8888</string>
					<string>2001:4860:4860::8844</string>
				</array>
				<key>ServerName</key>
				<string>dns.google</string>
			</dict>
			<key>PayloadDescription</key>
			<string>DNS over TLS via dns.google</string>
			<key>PayloadDisplayName</key>
			<string>DNS over TLS: Google Public DNS</string>
			<key>PayloadIdentifier</key>
			<string>tw.com.getinfo.dns.google.dot.dnsSettings</string>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadUUID</key>
			<string>3F5B4861-D4EF-5707-BB3D-24B28B231952</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>ProhibitDisablement</key>
			<false/>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Google Public DNS. General purpose resolver, no filtering.
Google 公共 DNS，一般用途，不做任何過濾。

DNS over TLS: dns.google</string>
	<key>PayloadDisplayName</key>
	<string>Google Public DNS (DoT)</string>
	<key>PayloadIdentifier</key>
	<string>tw.com.getinfo.dns.google.dot</string>
	<key>PayloadOrganization</key>
	<string>珈特科技股份有限公司 GET Technology Inc.</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>2B644913-E92A-5F7D-AE93-F058E9992A78</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
